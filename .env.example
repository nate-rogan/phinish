# Phinish — environment variable template.
# Copy to .env (gitignored) and fill in real values.
#   cp .env.example .env

# --- Phish.net API ----------------------------------------------------
# Required for: scripts/scrape.py (and the predict / process workflows
# in CI, where it's pulled from the PHISHNET_API_KEY repo secret).
# Get your key at https://phish.net/api/keys/.
PHISHNET_API_KEY=

# --- GitHub -----------------------------------------------------------
# These are auto-injected by GitHub Actions in CI. Only set them in
# .env if you want to dry-run scripts/process_issue.py or
# scripts/process_year.py against a real issue locally.
#
# GITHUB_TOKEN: a fine-grained PAT with issues:write on this repo, OR
#   gh auth token | tr -d '\n' | clip   (macOS: pbcopy)
# GITHUB_REPOSITORY: owner/repo, e.g. nate-rogan/phinish
# ISSUE_NUMBER: the issue id you're simulating
# ISSUE_BODY: the raw issue body (use the issue-form structure)
# ISSUE_AUTHOR: GitHub login of the issue author (predict only)

# GITHUB_TOKEN=
# GITHUB_REPOSITORY=nate-rogan/phinish
# ISSUE_NUMBER=
# ISSUE_BODY=
# ISSUE_AUTHOR=
